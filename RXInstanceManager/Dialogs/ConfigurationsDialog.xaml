<Window x:Class="RXInstanceManager.ConfigurationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RXInstanceManager"
        mc:Ignorable="d"
        Title="Конфигурации"
        Width="960" Height="560" MinWidth="720" MinHeight="420"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../UIResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ConfigurationsDialogButton" TargetType="Button" BasedOn="{StaticResource SaveCancelButton}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="180" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
          <ListBox x:Name="ConfigurationsList"
                   DisplayMemberPath="DisplayName"
                   BorderThickness="0"
                   Background="Transparent"
                   SelectionChanged="ConfigurationsList_SelectionChanged" />
        </Border>
        <Button x:Name="AddConfigurationButton"
                Grid.Row="1"
                Content="Добавить"
                Margin="0,8,0,0"
                Click="AddConfigurationButton_Click"
                Style="{StaticResource ConfigurationsDialogButton}" />
      </Grid>
      <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
        <TextBox x:Name="ConfigurationDetails"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent"
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 FontSize="12"
                 TextChanged="ConfigurationDetails_TextChanged" />
      </Border>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="SaveButton" Content="Сохранить" Width="120" Margin="0,0,8,0" Click="SaveButton_Click" Style="{StaticResource ConfigurationsDialogButton}" />
      <Button Content="Закрыть" Width="120" Click="CloseButton_Click" Style="{StaticResource ConfigurationsDialogButton}" />
    </StackPanel>
  </Grid>
</Window>
