<Window x:Class="RXInstanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RXInstanceManager"
        mc:Ignorable="d"
        Title="Менеджер экземпляров RX"
        Height="480" MinHeight="320" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Closing="OnClose" StateChanged="OnStateChanged" IsVisibleChanged="OnIsVisibleChanged"
        Background="{StaticResource Brush.Surface}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <!-- UIResources merged in App.xaml so StaticResource on Window resolves after dictionary load -->

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Chrome: info | действия | трей -->
    <Border Grid.Row="0" Background="{StaticResource Brush.Chrome}" Padding="10,6,10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="HiddenButton"
                Grid.Column="0"
                Content="i"
                Style="{StaticResource ToolbarButtonChrome}"
                Width="36" MinWidth="36"
                VerticalAlignment="Center"
                ToolTip="Информация о текущем проекте (map current)"
                Click="HiddenButton_Click" />
        <WrapPanel Grid.Column="1"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"
                   Margin="10,0,10,0">
          <Button x:Name="ButtonAdd" Content="Добавить" Style="{StaticResource ToolbarButtonAccent}" Click="ButtonAdd_Click" />
          <Button x:Name="ButtonStart" Content="do all up" Style="{StaticResource ToolbarButtonSuccess}" Click="ButtonStart_ClickAsync" />
          <Button x:Name="ButtonStop" Content="do all down" Style="{StaticResource ToolbarButtonDanger}" Click="ButtonStop_ClickAsync" />
          <Button x:Name="ButtonDDSStart" Content="Development Studio" Style="{StaticResource ToolbarButtonViolet}" Click="ButtonDDSStart_Click" />
          <Button x:Name="ButtonCDSStart" Content="CrossPlatform DevStudio" Style="{StaticResource ToolbarButtonTeal}" Click="ButtonCDSStart_Click" />
          <Button x:Name="ButtonRXStart" Content="Веб-клиент" Style="{StaticResource ToolbarButtonSky}" Click="ButtonRXStart_Click" />
          <Button x:Name="ButtonLogViewer" Content="Directum LogViewer" Style="{StaticResource ToolbarButtonMuted}" Click="RunDirectumLogViewer_Click" />
        </WrapPanel>
        <Button x:Name="ButtonDisableMinimizeToTray"
                Grid.Column="2"
                Content="●"
                Style="{StaticResource ToolbarButtonChrome}"
                Width="54" MinWidth="54"
                VerticalAlignment="Center"
                FontSize="10"
                ToolTip="Переключить сворачивание в трей"
                Click="ButtonDisableMinimizeToTray_Click" />
      </Grid>
    </Border>

    <!-- Data grid card -->
    <Border x:Name="InstancesCardBorder" Grid.Row="1" Margin="16,10,16,16" Padding="0" Background="{StaticResource Brush.Card}"
            VerticalAlignment="Stretch"
            CornerRadius="10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True"
            SizeChanged="InstancesCardBorder_SizeChanged">
      <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.06" Color="#0F172A"/>
      </Border.Effect>
      <DataGrid x:Name="GridInstances" AutoGenerateColumns="False" Style="{StaticResource DataGridStyle}"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                SelectionChanged="GridInstances_SelectionChanged" >
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding InstancePath}" Header="Путь" Width="150" />
          <DataGridTextColumn Binding="{Binding SolutionVersion}" Header="Версия" Width="80" />
          <DataGridTextColumn Binding="{Binding Status}" Header="Статус" Width="90" />
          <DataGridTextColumn Binding="{Binding URL}" Header="URL" Width="200" />
          <DataGridTextColumn Binding="{Binding Name}" Header="Назначение" Width="250" />
          <DataGridTextColumn Binding="{Binding ProjectConfigPath}" Header="Конфиг проекта" Width="250" />
          <DataGridTextColumn Binding="{Binding Code}" Header="Код" Width="70" />
          <DataGridTextColumn Binding="{Binding DBName}" Header="Имя БД" Width="170" />
        </DataGrid.Columns>
        <DataGrid.ContextMenu>
          <ContextMenu x:Name="InstancesContextMenu">
            <MenuItem x:Name="ChangeProject" Header="Сменить проект" Click="ChangeProject_ClickAsync" />
            <MenuItem x:Name="CreateProject" Header="Создать проект" Click="CreateProject_ClickAsync" />
            <MenuItem x:Name="CloneProject" Header="Создать копию текущего проекта" Click="CloneProject_Click" />
            <MenuItem x:Name="UpdateConfig" Header="Пропатчить config.yml" Click="UpdateConfig_Click" />
            <MenuItem x:Name="CheckServices" Header="Проверить сервисы" Click="CheckServices_Click" />
            <MenuItem x:Name="RunDDSWithOutDeploy" Header="Открыть DDS без deploy" Click="RunDDSWithOutDeploy_Click" />
            <Separator/>
            <MenuItem x:Name="InfoContext" Header="Сводка по инстансу" Click="InfoContext_Click" />
            <MenuItem x:Name="CmdAdminContext" Header="Запустить cmd (от администратора)" Click="CmdAdminContext_Click" />
            <Separator/>
            <MenuItem x:Name="ClearLogContext" Header="Очистить логи текущего экземпляра RX" Click="ClearLogContext_Click" />
            <MenuItem x:Name="ClearLogAllInstancesContext" Header="Очистить логи всех экземпляров RX" Click="ClearLogAllInstancesContext_Click" />
            <Separator/>
            <MenuItem x:Name="ConfigContext" Header="Открыть config.yml" Click="ConfigContext_Click" />
            <MenuItem x:Name="ProjectConfigContext" Header="Открыть конфиг проекта" Click="ProjectConfigContext_Click" />
            <MenuItem x:Name="ConvertDBsContext" Header="Конвертировать БД проектов" Click="ConvertDBsContext_Click" />
            <MenuItem x:Name="RemoveProjectDataContext" Header="Удалить БД и домашний каталог выбранного проекта" Click="RemoveProjectDataContext_Click" />
            <MenuItem x:Name="RemoveInstance" Header="Убрать экземпляр RX из списка" Click="RemoveInstance_Click" />
            <Separator/>
            <MenuItem x:Name="OpenRXFolder" Header="Открыть папку экземпляра RX" Click="OpenRXFolder_Click" />
            <MenuItem x:Name="OpenLogFolder" Header="Открыть папку логов" Click="OpenLogFolder_Click" />
          </ContextMenu>
        </DataGrid.ContextMenu>
      </DataGrid>
    </Border>
  </Grid>
</Window>
